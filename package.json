{
  "name": "shutdown-for-win",
  "version": "0.0.8",
  "description": "shutdown for win",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run type-check && electron-vite build",
    "prepare": "husky",
    "release": "commit-and-tag-version",
    "vite-build": "run-p type-check \"build-only {@}\" --",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write --experimental-cli src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xli33/shutdown-for-win.git"
  },
  "author": "Xli33",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Xli33/shutdown-for-win/issues"
  },
  "homepage": "https://github.com/Xli33/shutdown-for-win#readme",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "pinia": "^4.0.3",
    "quasar": "^2.26.0",
    "utils-where": "^0.5.2",
    "vue": "^3.5.41",
    "vue-i18n": "11.4.8",
    "vue-router": "^5.2.0"
  },
  "resolutions": {
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tsconfig/node24": "^24.0.5",
    "@types/adm-zip": "^0.5.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "@yellowspot/vite-plugin-externals": "^0.6.0",
    "commit-and-tag-version": "^13.1.2",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.79.0",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "less": "^4.9.0",
    "lint-staged": "^17.3.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-htmlx": "^1.0.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
